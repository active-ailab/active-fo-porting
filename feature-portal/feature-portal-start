#!/usr/bin/env bash
# Portable launcher for the bundled Feature Portal.
# Usage: feature-portal-start [--workspace PATH] [server.py options]
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"
if [[ -f "$SELF_DIR/server.py" ]]; then
  # 启动器被直接复制到 feature-portal 目录时。
  HERE="$SELF_DIR"
elif [[ -f "$SELF_DIR/scripts/feature-portal/server.py" ]]; then
  # 从 skill 根目录执行 feature-portal-start 时。
  HERE="$(cd "$SELF_DIR/scripts/feature-portal" && pwd)"
else
  # skill 的标准布局：scripts/feature-portal-start + scripts/feature-portal/。
  HERE="$(cd "$SELF_DIR/feature-portal" && pwd)"
fi
PYTHON="${PYTHON:-}"
if [[ -z "$PYTHON" ]]; then
  PYTHON="$(command -v python3 || command -v python || true)"
fi
if [[ -z "$PYTHON" ]]; then
  echo "python3 is required" >&2
  exit 127
fi

# Default behavior is intentionally one-step: start the service and open the
# system browser. Extra arguments still pass through for advanced use.
exec "$PYTHON" "$HERE/server.py" --open "$@"
